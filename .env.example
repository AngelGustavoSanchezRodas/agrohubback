# ==============================================================================
# ARCHIVO DE CONFIGURACION DE EJEMPLO (.env.example) - AgroHub Data Engine
# Copia este archivo como .env en la raiz del proyecto y completa con los valores reales:
# cp .env.example .env (Linux/macOS) o copy .env.example .env (Windows)
# ==============================================================================

# --- CONFIGURACION DE FIREBASE ---
# Ruta local al archivo JSON de credenciales de la cuenta de servicio de Firebase.
# Este archivo se descarga desde: Consola de Firebase -> Configuracion del proyecto -> Cuentas de servicio -> Generar nueva clave privada.
FIREBASE_CREDENTIALS=firebase-credentials.json

# URL de la base de datos en tiempo real (Firebase Realtime Database).
# Formato: https://<tu-proyecto>-default-rtdb.firebaseio.com/
FIREBASE_URL=https://<tu-proyecto>-default-rtdb.firebaseio.com/

# --- CONFIGURACION DE SUPABASE ---
# URL base de tu proyecto en Supabase.
# Ubicacion: Panel de Supabase -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://<tu-id-proyecto>.supabase.co

# Llave de acceso de Supabase (CRITICO: Usar la clave service_role secreta para acceso backend con bypass de RLS)
# Ubicacion: Panel de Supabase -> Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
# O alternativamente SUPABASE_KEY:
SUPABASE_KEY=tu_service_role_key_aqui

# Dominio del Frontend para autorizacion CORS
FRONTEND_URL= url del front

# --- SEGURIDAD: COMUNICACION SEGURA CON EL FRONTEND (API KEY) ---
# Clave secreta requerida en la cabecera 'X-API-Key' para autorizar peticiones provenientes del dashboard Next.js
API_KEY_SECRETA=tu_api_key_secreta_del_frontend_aqui

# --- CONFIGURACION DE INTELIGENCIA ARTIFICIAL (GEMINI) ---
# Clave API de Google AI Studio para el servicio de diagnostico agronomico asistido por IA.
GEMINI_API_KEY=tu_gemini_api_key_aqui
# Modelo de Google Gemini utilizado (gemini-3.1-flash-lite para alta disponibilidad y baja latencia)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- PROGRAMADOR DE TAREAS EN SEGUNDO PLANO (MODO HIBRIDO) ---
# Habilita el barrido periodico automatico de diagnostico agronomico (true o false).
IA_SCHEDULER_HABILITADO=true
# Intervalo de ejecucion en minutos (240 minutos = 4 horas).
IA_SCHEDULER_INTERVALO_MINUTOS=240
