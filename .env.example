# ==============================================================================
# ARCHIVO DE CONFIGURACION DE EJEMPLO (.env.example)
# Copia este archivo como .env en la raiz del proyecto y completa con tus valores reales:
# cp .env.example .env (Linux/macOS) o copy .env.example .env (Windows)
# ==============================================================================

# --- CONFIGURACION DE FIREBASE ---
# Ruta local al archivo JSON de credenciales de la cuenta de servicio de Firebase.
# Este archivo se descarga desde: Consola de Firebase -> Configuracion del proyecto -> Cuentas de servicio -> Generar nueva clave privada.
FIREBASE_CREDENTIALS=firebase-credentials.json

# URL de la base de datos en tiempo real (Firebase Realtime Database).
# Formato: https://<tu-proyecto>-default-rtdb.firebaseio.com/
FIREBASE_URL=https://<tu-proyecto>-default-rtdb.firebaseio.com/

# --- CONFIGURACION DE SUPABASE ---
# URL base de tu proyecto en Supabase.
# Ubicacion: Panel de Supabase -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://<tu-id-proyecto>.supabase.co

# Llave de acceso de Supabase (service_role key para operaciones backend o anon key).
# Ubicacion: Panel de Supabase -> Project Settings -> API -> Project API Keys.
SUPABASE_KEY=tu_clave_supabase_aqui

# --- CONFIGURACION DE SEGURIDAD (JWT) ---
# Clave secreta compartida utilizada para firmar y validar tokens de autenticacion JWT (HS256).
# Debe coincidir con la configuracion del frontend o servicio de autenticacion.
JWT_SECRET=tu_clave_secreta_jwt_aqui

# --- CONFIGURACION DE API KEY ---
# Clave estatica esperada en la cabecera 'X-API-Key' para autorizar comandos de actuadores.
API_KEY_SECRETA=clave_estatica_agrohub_123
